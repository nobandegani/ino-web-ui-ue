{
	"FileVersion": 3,
	"EngineVersion": "5.7.0",
	"Version": 13,
	"VersionName": "1.8.4",
	"FriendlyName": "InoWebUI",
	"Description": "Native WebView overlay for Unreal Engine: a real OS window composited above the game, not a render-to-texture. Win64 (WebView2) / Android (android.webkit.WebView) / iOS (WKWebView) with two-way JSON messaging, virtual-host local content, navigation lockdown and hardened security defaults. Requires borderless-windowed mode - exclusive fullscreen bypasses the compositor.",
	"Category": "UI",
	"CreatedBy": "Inoland",
	"CreatedByURL": "https://github.com/nobandegani",
	"DocsURL": "https://github.com/nobandegani/ino-web-ui-ue#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/nobandegani/ino-web-ui-ue/issues",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Plugins": [
		{
			"Name": "JsonBlueprintUtilities",
			"Enabled": true
		}
	],
	"Modules": [
		{
			"Name": "InoWebUI",
			"Type": "Runtime",
			"LoadingPhase": "PreLoadingScreen"
		},
		{
			"Name": "InoWebUIEditor",
			"Type": "Editor",
			"LoadingPhase": "Default"
		}
	]
}

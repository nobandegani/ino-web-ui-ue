<?xml version="1.0" encoding="utf-8"?>
<!--
  InoWebUI plugin — Android build additions.

  Copies the Java helper into the APK build, adds the INTERNET permission
  (needed for https:// loads), and wires GameActivity's lifecycle callbacks
  into the helper's onActivityPause / onActivityResume / onActivityDestroy.
-->
<root xmlns:android="http://schemas.android.com/apk/res/android">

    <init>
        <log text="InoWebUI: UPL init (Android)"/>
    </init>

    <!-- Network access for https:// content -->
    <androidManifestUpdates>
        <addPermission android:name="android.permission.INTERNET"/>
    </androidManifestUpdates>

    <!-- Copy the Java helper into the APK build tree -->
    <resourceCopies>
        <copyDir src="$S(PluginDir)/Java" dst="$S(BuildDir)" />
    </resourceCopies>

    <!--
      AndroidX WebKit — provides WebViewCompat.addDocumentStartJavaScript,
      the Android counterpart of WebView2's AddScriptToExecuteOnDocumentCreated
      and WKUserScriptInjectionTimeAtDocumentStart. It guarantees the
      window.InoWebUI bridge runs BEFORE any page script on every navigation,
      eliminating the onPageStarted+evaluateJavascript race. The Java side
      feature-detects (WebViewFeature.DOCUMENT_START_SCRIPT) and falls back
      to onPageStarted injection on pre-2020 System WebView, so this
      dependency is required but its API is used conditionally.

      Version 1.16.0 (current stable, May 2026) requires min SDK 24 — well
      below our project's min SDK 28. Brings @UiThread / @AnyThread lint
      annotations, async startup (`WebViewCompat.startUpWebView`), navigation
      listener APIs, per-Profile cookie/storage isolation (`MULTI_PROFILE`),
      ArrayBuffer support over postMessage (`WEB_MESSAGE_ARRAY_BUFFER`),
      and the recommended `WebMessageListener` API as a hardened replacement
      for `addJavascriptInterface`. Drop-in upgrade — the methods we use
      (`addDocumentStartJavaScript`, the `DOCUMENT_START_SCRIPT` feature
      check) are source-compatible.

      Requires AndroidX (UE 5.x enables android.useAndroidX by default).
      Builds against compileSdk 34+; UE 5.7's default is 34.
    -->
    <buildGradleAdditions>
        <insert>
dependencies {
    implementation "androidx.webkit:webkit:1.16.0"
}
        </insert>
    </buildGradleAdditions>

    <!-- Import the helper class into GameActivity so our lifecycle hooks resolve -->
    <gameActivityImportAdditions>
        <insert>
import net.inoland.webui.InoWebViewAndroid;
        </insert>
    </gameActivityImportAdditions>

    <!-- Forward Android Activity lifecycle into the helper -->
    <gameActivityOnPauseAdditions>
        <insert>
        InoWebViewAndroid.onActivityPause();
        </insert>
    </gameActivityOnPauseAdditions>

    <gameActivityOnResumeAdditions>
        <insert>
        InoWebViewAndroid.onActivityResume();
        </insert>
    </gameActivityOnResumeAdditions>

    <gameActivityOnDestroyAdditions>
        <insert>
        InoWebViewAndroid.onActivityDestroy();
        </insert>
    </gameActivityOnDestroyAdditions>

    <!-- Keep ProGuard / R8 from stripping our helper; it's called via JNI -->
    <proguardAdditions>
        <insert>
-keep class net.inoland.webui.InoWebViewAndroid {
    public *;
}
        </insert>
    </proguardAdditions>

</root>
